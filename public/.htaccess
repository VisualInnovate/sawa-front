# SPA fallback: serve index.html for any path that is not a real file or folder,
# so refreshing a page such as /sawa-admin/bookings keeps the same route.
# Lives in public/ so every build ships it inside dist/ (the deploy wipes dist/).
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  # The old test address of this build is closed: only the dashboard's own domain serves it.
  RewriteCond %{HTTP_HOST} ^attendance\.test\.sawa\.academy$ [NC]
  RewriteRule ^ - [F,L]
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# index.html is never cached: after a deploy the browser always gets the page that points at the new files
# (a cached old page asked for JS files a deploy had removed, and the site opened blank).
# Built files carry a hash in their name, so they are cached for a year.
<IfModule mod_headers.c>
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
  <If "%{REQUEST_URI} =~ m#^/assets/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
</IfModule>

# Compressed transfer: the app's JavaScript is ~2.4 MB and went uncompressed (about 650 KB compressed), so the first
# page after a deploy, and every page on a slow connection, waited for it.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/x-javascript application/json application/manifest+json image/svg+xml font/ttf font/otf application/vnd.ms-fontobject
</IfModule>

# Protective headers: HTTPS only, no MIME guessing, no framing by other sites, and a careful referrer.
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(self), microphone=(self), geolocation=(self), payment=()"
</IfModule>

# Source and config files are never served (only the built app is).
<FilesMatch "^(package(-lock)?\.json|vite\.config\.js|\.env.*|composer\.(json|lock))$">
  Require all denied
</FilesMatch>
