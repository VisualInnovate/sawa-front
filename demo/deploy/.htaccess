# .htaccess لنطاق الديمو المستقل (demo.360enable.com): يُوضع في جذر مجلد النطاق بدل .htaccess النظام.
# - الزائر الذي يفتح الجذر «/» يُحوَّل إلى /demo/ (الشِّل). طلبات الإطارَين (Sec-Fetch-Dest: iframe) لا تُحوَّل
#   لأن الإطارَين يحمّلان التطبيق نفسه من مسارات مثل /web/... و/sessions.
# - كل مسار ليس ملفاً أو مجلداً حقيقياً يُخدَم من index.html (تطبيق صفحة واحدة)، و/demo/ مجلد حقيقي فيه index.html.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{HTTP:Sec-Fetch-Dest} !=iframe
  RewriteRule ^$ /demo/ [R=302,L]

  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>

# الملفات المبنية تحمل بصمة في اسمها فتُخزَّن طويلاً؛ ملفات HTML لا تُخزَّن حتى يصل كل تحديث فوراً.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|svg|png|jpg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# ضغط النقل إن كان متاحاً (الحزمة الرئيسية 1.8 MB قبل الضغط).
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
